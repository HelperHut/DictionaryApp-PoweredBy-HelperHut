<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dictionary App</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f8f9fa;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial;
        }

        .app-header {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            padding: 15px 0;
        }

        .app-title {
            font-size: 20px;
            font-weight: 600;
            color: #111827;
            margin: 0;
        }

        .card {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            box-shadow: none;
        }

        .form-control {
            border-radius: 8px;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .btn-primary {
            background: #2563eb;
            border: none;
            border-radius: 8px;
            padding: 10px;
            font-weight: 500;
        }

        .btn-primary:hover {
            background: #1d4ed8;
        }

        label {
            font-weight: 500;
            color: #374151;
        }
    </style>
</head>

<body>

<!-- Header -->
<div class="app-header">
    <div class="container">
        <h1 class="app-title">Dictionary App</h1>
    </div>
</div>


<!-- Error Message -->
<% if (err) { %>

    <div class="alert container mt-2 alert-danger">
        <%= err %>
    </div>

<% } %>

<!-- Success Message -->
<% if (msg) { %>

    <div class="alert container mt-2 alert-success">
        <%= msg %>
    </div>

<% } %>

<!-- Form Section -->
<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card p-4">

                <form action="/" method="post">

                    <div class="mb-3">
                        <label>English Word</label>
                        <input type="text" name="englishWord" class="form-control" placeholder="Enter English word" required>
                    </div>

                    <div class="mb-4">
                        <label>Bangla Word</label>
                        <input type="text" name="banglaWord" class="form-control" placeholder="বাংলা শব্দ লিখুন" required>
                    </div>

                    <button class="btn btn-primary w-100">
                        Save Word
                    </button>

                </form>

            </div>

        </div>
    </div>

</div>

</body>
</html>